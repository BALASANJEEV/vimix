NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/vimix_crm
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=https://crm.example.com
REDIS_URL=rediss://default:password@redis.example.com:6379
# Mount an EFS volume here if uploads must survive task replacement.
UPLOAD_DIR=/app/uploads
ALLOW_PUBLIC_SIGNUP=false
